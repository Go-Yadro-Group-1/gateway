# gateway — per-service environment configuration.
#
# Copy to .env and fill in. Loaded automatically on `serve` via godotenv.
# Values here OVERRIDE the baked YAML (config/*.yaml). The gateway is stateless
# and has no secrets, but on a deploy target that only accepts env vars
# (e.g. Timeweb App Platform) these keys can drive the entire config.

# --- HTTP server ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Upstream gRPC services (host:port) ---
ANALYZER_ADDRESS=analyzer:50051
CONNECTOR_ADDRESS=connector:50052

# --- App ---
LOG_LEVEL=info          # debug | info | warn | error
