        },
        "selfUrl": {
          "type": "string",
          "title": "Jira self-link"
        },
        "existence": {
          "type": "boolean",
          "title": "true if the project is already loaded into the database"
        }
      },
      "description": "JiraProject — project from Jira with a flag indicating whether it is loaded into the database."
    },
    "v1ListJiraProjectsResponse": {
      "type": "object",
      "properties": {
