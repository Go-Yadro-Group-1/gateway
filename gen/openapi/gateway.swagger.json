          "format": "int32"
        },
        "countReopened": {
          "type": "integer",
          "format": "int32"
        },
        "countResolved": {
          "type": "integer",
          "format": "int32"
        },
        "countInProgress": {
          "type": "integer",
          "format": "int32"
        },
        "totalDurationClosed": {
          "type": "integer",
          "format": "int32",
          "title": "Total closed duration in days"
        },
        "countCreatedLastWeek": {
          "type": "integer",
          "format": "int32"
        }
