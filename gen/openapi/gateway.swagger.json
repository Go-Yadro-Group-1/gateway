  "paths": {
    "/api/v1/analytics/charts": {
      "get": {
        "summary": "GetChart returns aggregated chart data for a project.",
        "operationId": "AnalyticsService_GetChart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetChartResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "chartType",
            "description": " - CHART_TYPE_OPEN_STATE_HISTOGRAM: Duration histogram for open issues\n - CHART_TYPE_STATE_DISTRIBUTION: Issue count by status\n - CHART_TYPE_COMPLEXITY_HISTOGRAM: Time-spent histogram\n - CHART_TYPE_PRIORITY: Issue count by priority\n - CHART_TYPE_DAILY_ACTIVITY: Daily created/closed activity",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "CHART_TYPE_UNSPECIFIED",
              "CHART_TYPE_OPEN_STATE_HISTOGRAM",
              "CHART_TYPE_STATE_DISTRIBUTION",
              "CHART_TYPE_COMPLEXITY_HISTOGRAM",
              "CHART_TYPE_PRIORITY",
              "CHART_TYPE_DAILY_ACTIVITY"
            ],
            "default": "CHART_TYPE_UNSPECIFIED"
          }
        ],
        "tags": [
          "AnalyticsService"
        ]
      }
    },
    "/api/v1/analytics/compare": {
      "get": {
        "summary": "CompareProjects returns stats for two projects side by side.",
        "operationId": "AnalyticsService_CompareProjects",
